<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="FieldsToArrowheadService" Comment="Translate individual fields to an ArrowheadService type">
	<Identification Standard="61499-2" Description="Copyright (c) 2018 fortiss GmbH&#10; &#10;This program and the accompanying materials are made&#10;available under the terms of the Eclipse Public License 2.0&#10;which is available at https://www.eclipse.org/legal/epl-2.0/&#10;&#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="fortiss GmbH" Version="1.0" Author="Jose Cabral" Date="2018-09-21">
	</VersionInfo>
	<InterfaceList>
		<EventInputs>
			<Event Name="REQ" Type="Event" Comment="Create arrowhead service">
				<With Var="serviceDefinition"/>
				<With Var="interfaces"/>
				<With Var="serviceMetadata"/>
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="CNF" Type="Event" Comment="Arrowhead service created">
				<With Var="arrowheadService"/>
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="serviceDefinition" Type="WSTRING" Comment="Identification of the service"/>
			<VarDeclaration Name="interfaces" Type="WSTRING" Comment="Interfaces implemented by the service" ArraySize="10"/>
			<VarDeclaration Name="serviceMetadata" Type="WSTRING" Comment="Metadata of the service in key=value format" ArraySize="10"/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="arrowheadService" Type="ArrowheadService" Comment="Created Arrowhead service"/>
		</OutputVars>
	</InterfaceList>
	<BasicFB>
		<ECC>
			<ECState Name="START" Comment="Initial State" x="555" y="425">
			</ECState>
			<ECState Name="REQ" Comment="Normal execution" x="215" y="755">
				<ECAction Algorithm="REQ" Output="CNF"/>
			</ECState>
			<ECTransition Source="START" Destination="REQ" Condition="REQ" Comment="" x="555" y="600"/>
			<ECTransition Source="REQ" Destination="START" Condition="1" Comment="" x="215" y="425"/>
		</ECC>
		<Algorithm Name="REQ">
			<ST><![CDATA[ALGORITHM REQ

VAR_TEMP
	i : INT;
END_VAR
;

i := 0;
arrowheadService.serviceDefinition := serviceDefinition;

WHILE i < 10 DO // looks like while is faster than FOR when exporting to cpp
	arrowheadService.interfaces[i] := interfaces[i];
	arrowheadService.serviceMetadata[i] := serviceMetadata[i];
	i := i + 1;
END_WHILE;
END_ALGORITHM

]]></ST>
		</Algorithm>
	</BasicFB>
</FBType>
