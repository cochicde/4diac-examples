		</FB>
		<FB Name="Register" Type="CLIENT_1_2" x="12200" y="-500">
		</FB>
		<FB Name="Unregister" Type="CLIENT_1_2" x="12175" y="1600">
		</FB>
		<FB Name="CreateRegisterID_1" Type="APPEND_STRING_3" x="5500" y="1500">
			<Parameter Name="IN_1" Value="STRING#'http[]'"/>
			<Parameter Name="IN_3" Value="STRING#'/subscription; PUT; application/json]'"/>
		</FB>
		<FB Name="F_STRING_TO_WSTRING_2" Type="F_STRING_TO_WSTRING" x="6700" y="1500">
		</FB>
		<EventConnections>
