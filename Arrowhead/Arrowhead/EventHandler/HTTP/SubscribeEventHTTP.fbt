			<Connection Source="Register.CNF" Destination="InitFlagReg.R" dx1="325" dx2="265" dy="-975"/>
			<Connection Source="InitFlagReg.EO" Destination="Register.INIT" dx1="1160"/>
			<Connection Source="CreateRegisterID.CNF" Destination="F_STRING_TO_WSTRING.REQ"/>
			<Connection Source="F_STRING_TO_WSTRING.CNF" Destination="ANYToJSON.REQ" dx1="265"/>
			<Connection Source="E_PERMIT.EO" Destination="Register.REQ" dx1="290"/>
			<Connection Source="F_STRING_TO_WSTRING.CNF" Destination="InitFlagReg.S" dx1="955"/>
			<Connection Source="SubscribeEventAdp.Subscribe" Destination="CreateRegisterID.REQ" dx1="975"/>
			<Connection Source="Register.CNF" Destination="SubscribeEventAdp.Subscribed" dx1="540" dx2="540" dy="-1415"/>
			<Connection Source="InitFlagUnReg.EO" Destination="Unregister.INIT" dx1="1085"/>
			<Connection Source="E_PERMIT_1.EO" Destination="Unregister.REQ" dx1="290"/>
			<Connection Source="Unregister.INITO" Destination="E_PERMIT_1.EI" dx1="60" dx2="60" dy="-1155"/>
			<Connection Source="Unregister.CNF" Destination="SubscribeEventAdp.Unsubscribed" dx1="680" dx2="680" dy="4405"/>
			<Connection Source="Unregister.CNF" Destination="InitFlagUnReg.R" dx1="350" dx2="290" dy="-1435"/>
			<Connection Source="SubscribeEventAdp.Unsubscribe" Destination="CreateRegisterID_1.REQ" dx1="385"/>
			<Connection Source="CreateRegisterID_1.CNF" Destination="F_STRING_TO_WSTRING_2.REQ"/>
			<Connection Source="F_STRING_TO_WSTRING_2.CNF" Destination="ANYToJSON.REQ" dx1="355"/>
			<Connection Source="F_STRING_TO_WSTRING_2.CNF" Destination="InitFlagUnReg.S" dx1="1260"/>
		</EventConnections>
		<DataConnections>
			<Connection Source="InitFlagUnReg.Q" Destination="E_PERMIT_1.PERMIT" dx1="720"/>
			<Connection Source="InitFlagReg.Q" Destination="Register.QI" dx1="1160"/>
