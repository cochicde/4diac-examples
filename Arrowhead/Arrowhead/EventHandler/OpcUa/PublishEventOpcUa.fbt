<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="PublishEventOpcUa" Comment="Publish event using OPC UA">
	<Identification Standard="61499-2" Description="Copyright (c) 2019 fortiss GmbH&#10; &#10;This program and the accompanying materials are made&#10;available under the terms of the Eclipse Public License 2.0&#10;which is available at https://www.eclipse.org/legal/epl-2.0/&#10;&#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="fortiss GmbH" Version="1.0" Author="Cabral" Date="2019-09-17">
	</VersionInfo>
	<InterfaceList>
		<Sockets>
			<AdapterDeclaration Name="publishEvent" Type="ArrowheadPublishAdp" Comment="Publish Event adapter" x="1300" y="700"/>
		</Sockets>
	</InterfaceList>
	<FBNetwork>
		<FB Name="ANYToJSON" Type="ANYToJSON" x="4560" y="335">
		</FB>
		<FB Name="InitFlag" Type="E_SR" x="8075" y="625">
		</FB>
		<FB Name="APPEND_STRING_3" Type="APPEND_STRING_3" x="5400" y="1000">
			<Parameter Name="IN_1" Value="STRING#'opc_ua[CALL_METHOD;'"/>
			<Parameter Name="IN_3" Value="STRING#'#;/Objects/2:EventHandler/2:publish]'"/>
		</FB>
		<FB Name="F_STRING_TO_WSTRING" Type="F_STRING_TO_WSTRING" x="6795" y="1025">
		</FB>
		<FB Name="E_PERMIT" Type="E_PERMIT" x="8700" y="-200">
		</FB>
		<FB Name="E_SWITCH_2" Type="E_SWITCH" x="11100" y="800">
		</FB>
		<FB Name="E_SWITCH_1_1" Type="E_SWITCH" x="13000" y="700">
		</FB>
		<FB Name="E_CTU_1" Type="E_CTU" x="12200" y="800">
			<Parameter Name="PV" Value="UINT#3"/>
		</FB>
		<FB Name="E_DELAY_1" Type="E_DELAY" x="14600" y="700">
			<Parameter Name="DT" Value="T#250ms"/>
		</FB>
		<FB Name="Query" Type="CLIENT_1_0" x="9700" y="610">
		</FB>
		<EventConnections>
			<Connection Source="APPEND_STRING_3.CNF" Destination="F_STRING_TO_WSTRING.REQ" dx1="285"/>
			<Connection Source="ANYToJSON.CNF" Destination="APPEND_STRING_3.REQ" dx1="180"/>
			<Connection Source="F_STRING_TO_WSTRING.CNF" Destination="InitFlag.S" dx1="190"/>
			<Connection Source="publishEvent.publish" Destination="ANYToJSON.REQ" dx1="1110"/>
			<Connection Source="E_SWITCH_2.EO1" Destination="E_CTU_1.R"/>
			<Connection Source="E_SWITCH_1_1.EO1" Destination="E_CTU_1.R" dx1="60" dx2="60" dy="-505"/>
			<Connection Source="E_SWITCH_2.EO0" Destination="E_CTU_1.CU"/>
			<Connection Source="E_CTU_1.CUO" Destination="E_SWITCH_1_1.EI" dx1="230"/>
			<Connection Source="E_SWITCH_1_1.EO0" Destination="E_DELAY_1.START"/>
			<Connection Source="E_SWITCH_2.EO1" Destination="publishEvent.published" dx1="445" dx2="60" dy="-1930"/>
			<Connection Source="E_SWITCH_2.EO1" Destination="InitFlag.R" dx1="260" dx2="150" dy="-1650"/>
			<Connection Source="InitFlag.EO" Destination="Query.INIT" dx1="295"/>
			<Connection Source="E_PERMIT.EO" Destination="Query.REQ" dx1="225"/>
			<Connection Source="E_DELAY_1.EO" Destination="Query.REQ" dx1="60" dx2="60" dy="-1010"/>
			<Connection Source="Query.INITO" Destination="E_PERMIT.EI" dx1="60" dx2="60" dy="-1290"/>
			<Connection Source="Query.CNF" Destination="E_SWITCH_2.EI" dx1="420"/>
			<Connection Source="E_SWITCH_1_1.EO1" Destination="InitFlag.R" dx1="60" dx2="60" dy="785"/>
			<Connection Source="E_SWITCH_1_1.EO1" Destination="publishEvent.published" dx1="60" dx2="600" dy="1580"/>
		</EventConnections>
		<DataConnections>
			<Connection Source="APPEND_STRING_3.OUT" Destination="F_STRING_TO_WSTRING.IN" dx1="285"/>
			<Connection Source="InitFlag.Q" Destination="E_PERMIT.PERMIT" dx1="205"/>
			<Connection Source="publishEvent.publishEvent" Destination="ANYToJSON.input" dx1="1430"/>
			<Connection Source="publishEvent.endpoint" Destination="APPEND_STRING_3.IN_2" dx1="1530"/>
			<Connection Source="E_CTU_1.Q" Destination="E_SWITCH_1_1.G" dx1="230"/>
			<Connection Source="InitFlag.Q" Destination="Query.QI" dx1="370"/>
			<Connection Source="F_STRING_TO_WSTRING.OUT" Destination="Query.ID" dx1="840"/>
			<Connection Source="ANYToJSON.output" Destination="Query.SD_1" dx1="4045"/>
			<Connection Source="Query.QO" Destination="E_SWITCH_2.G" dx1="420"/>
		</DataConnections>
	</FBNetwork>
</FBType>
