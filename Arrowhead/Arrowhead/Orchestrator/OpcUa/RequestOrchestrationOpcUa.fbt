<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="RequestOrchestrationOpcUa" Comment="Request Orchestration Function Block using OPC UA">
	<Identification Standard="61499-2" Description="Copyright (c) 2019 fortiss GmbH&#10; &#10;This program and the accompanying materials are made&#10;available under the terms of the Eclipse Public License 2.0&#10;which is available at https://www.eclipse.org/legal/epl-2.0/&#10;&#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="fortiss GmbH" Version="1.0" Author="Jose Cabral" Date="2019-09-17">
	</VersionInfo>
	<InterfaceList>
		<Sockets>
			<AdapterDeclaration Name="requestOrchestration" Type="OrchestratorRequestAdp" Comment="Request orchestration adapter" x="1000" y="1500"/>
		</Sockets>
	</InterfaceList>
	<FBNetwork>
		<FB Name="APPEND_STRING_3" Type="APPEND_STRING_3" x="4975" y="1830">
			<Parameter Name="IN_1" Value="STRING#'opc_ua[CALL_METHOD; '"/>
			<Parameter Name="IN_3" Value="STRING#'#; /Objects/2:Orchestrator/2:orchestration]'"/>
		</FB>
		<FB Name="InitFlag" Type="E_SR" x="7445" y="1665">
		</FB>
		<FB Name="E_PERMIT" Type="E_PERMIT" x="8065" y="1250">
		</FB>
		<FB Name="F_STRING_TO_WSTRING" Type="F_STRING_TO_WSTRING" x="6010" y="1875">
		</FB>
		<FB Name="ANYToJSON" Type="ANYToJSON" x="3755" y="1475">
		</FB>
		<FB Name="GetHTTPOrchestrationForm" Type="GetArrayResponseFromJSON" x="-400" y="1500">
		</FB>
		<FB Name="Request" Type="CLIENT_1" x="9240" y="1905">
		</FB>
		<FB Name="E_SWITCH" Type="E_SWITCH" x="11100" y="1900">
		</FB>
		<FB Name="E_SWITCH_1" Type="E_SWITCH" x="13000" y="1800">
		</FB>
		<FB Name="E_CTU" Type="E_CTU" x="12200" y="1800">
			<Parameter Name="PV" Value="UINT#3"/>
		</FB>
		<FB Name="E_DELAY" Type="E_DELAY" x="14600" y="1800">
			<Parameter Name="DT" Value="T#250ms"/>
		</FB>
		<EventConnections>
			<Connection Source="APPEND_STRING_3.CNF" Destination="F_STRING_TO_WSTRING.REQ" dx1="155"/>
			<Connection Source="F_STRING_TO_WSTRING.CNF" Destination="InitFlag.S" dx1="305"/>
			<Connection Source="ANYToJSON.CNF" Destination="APPEND_STRING_3.REQ" dx1="245"/>
			<Connection Source="requestOrchestration.requestOrchestator" Destination="ANYToJSON.REQ" dx1="840"/>
			<Connection Source="GetHTTPOrchestrationForm.CNF" Destination="requestOrchestration.responseReceived"/>
			<Connection Source="InitFlag.EO" Destination="Request.INIT" dx1="620"/>
			<Connection Source="E_PERMIT.EO" Destination="Request.REQ" dx1="240"/>
			<Connection Source="Request.INITO" Destination="E_PERMIT.EI" dx1="60" dx2="60" dy="-1150"/>
			<Connection Source="E_SWITCH.EO1" Destination="GetHTTPOrchestrationForm.REQ" dx1="445" dx2="60" dy="-1945"/>
			<Connection Source="E_SWITCH.EO1" Destination="InitFlag.R" dx1="240" dx2="60" dy="-1605"/>
			<Connection Source="Request.CNF" Destination="E_SWITCH.EI" dx1="655"/>
			<Connection Source="E_SWITCH.EO0" Destination="E_CTU.CU" dx1="310"/>
			<Connection Source="E_DELAY.EO" Destination="Request.REQ" dx1="60" dx2="60" dy="-685"/>
			<Connection Source="E_CTU.CUO" Destination="E_SWITCH_1.EI"/>
			<Connection Source="E_SWITCH_1.EO0" Destination="E_DELAY.START"/>
			<Connection Source="E_SWITCH_1.EO1" Destination="InitFlag.R" dx1="60" dx2="60" dy="1490"/>
			<Connection Source="E_SWITCH_1.EO1" Destination="GetHTTPOrchestrationForm.REQ" dx1="305" dx2="205" dy="1875"/>
			<Connection Source="E_SWITCH.EO1" Destination="E_CTU.R" dx1="310"/>
			<Connection Source="E_SWITCH_1.EO1" Destination="E_CTU.R" dx1="60" dx2="60" dy="120"/>
		</EventConnections>
		<DataConnections>
			<Connection Source="APPEND_STRING_3.OUT" Destination="F_STRING_TO_WSTRING.IN" dx1="155"/>
			<Connection Source="InitFlag.Q" Destination="E_PERMIT.PERMIT" dx1="170"/>
			<Connection Source="requestOrchestration.serviceRequestForm" Destination="ANYToJSON.input" dx1="840"/>
			<Connection Source="requestOrchestration.endpoint" Destination="APPEND_STRING_3.IN_2" dx1="615"/>
			<Connection Source="GetHTTPOrchestrationForm.output" Destination="requestOrchestration.orchestrationResponse"/>
			<Connection Source="InitFlag.Q" Destination="Request.QI" dx1="740"/>
			<Connection Source="F_STRING_TO_WSTRING.OUT" Destination="Request.ID" dx1="1055"/>
			<Connection Source="ANYToJSON.output" Destination="Request.SD_1" dx1="325"/>
			<Connection Source="Request.RD_1" Destination="GetHTTPOrchestrationForm.response" dx1="60" dx2="60" dy="310"/>
			<Connection Source="Request.QO" Destination="E_SWITCH.G" dx1="655"/>
			<Connection Source="E_CTU.Q" Destination="E_SWITCH_1.G"/>
		</DataConnections>
	</FBNetwork>
</FBType>
