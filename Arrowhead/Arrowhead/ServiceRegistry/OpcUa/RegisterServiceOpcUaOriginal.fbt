<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="RegisterServiceOpcUaOriginal" Comment="Register Service using OPC UA">
	<Identification Standard="61499-2" Description="Copyright (c) 2019 fortiss GmbH&#10; &#10;This program and the accompanying materials are made&#10;available under the terms of the Eclipse Public License 2.0&#10;which is available at https://www.eclipse.org/legal/epl-2.0/&#10;&#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="fortiss GmbH" Version="1.0" Author="Jose Cabral" Date="2019-09-17">
	</VersionInfo>
	<InterfaceList>
		<EventOutputs>
			<Event Name="registryDone" Type="Event">
				<With Var="registryStatus"/>
			</Event>
		</EventOutputs>
		<OutputVars>
			<VarDeclaration Name="registryStatus" Type="STRING"/>
		</OutputVars>
		<Sockets>
			<AdapterDeclaration Name="registerService" Type="RegisterServiceAdp" Comment="Register Service adapter" x="-155" y="1810"/>
		</Sockets>
	</InterfaceList>
	<FBNetwork>
		<FB Name="CreateRegisterID" Type="APPEND_STRING_3" x="3400" y="900">
			<Parameter Name="IN_1" Value="STRING#'opc_ua[]'"/>
			<Parameter Name="IN_3" Value="STRING#'#(2:,register,)]'"/>
		</FB>
		<FB Name="F_STRING_TO_WSTRING" Type="F_STRING_TO_WSTRING" x="4600" y="900">
		</FB>
		<FB Name="CreateUnRegisterID" Type="APPEND_STRING_3" x="3400" y="3000">
			<Parameter Name="IN_1" Value="STRING#'opc_ua[]'"/>
			<Parameter Name="IN_3" Value="STRING#'#(2:,remove,)]'"/>
		</FB>
		<FB Name="F_STRING_TO_WSTRING_1" Type="F_STRING_TO_WSTRING" x="4585" y="3000">
		</FB>
		<FB Name="ANYToJSON" Type="ANYToJSON" x="6000" y="1905">
		</FB>
		<FB Name="CLIENT_1_0" Type="CLIENT_1_0" x="10100" y="2000">
			<Parameter Name="QI" Value="1"/>
		</FB>
		<FB Name="CLIENT_1_0_1" Type="CLIENT_1" x="10800" y="700">
			<Parameter Name="QI" Value="1"/>
		</FB>
		<FB Name="STRING2STRING" Type="STRING2STRING" x="11700" y="800">
		</FB>
		<FB Name="E_DELAY" Type="E_DELAY" x="10000" y="300">
			<Parameter Name="DT" Value="T#1s"/>
		</FB>
		<FB Name="E_DELAY_1" Type="E_DELAY" x="9300" y="1400">
			<Parameter Name="DT" Value="T#1s"/>
		</FB>
		<EventConnections>
			<Connection Source="CreateRegisterID.CNF" Destination="F_STRING_TO_WSTRING.REQ"/>
			<Connection Source="CreateUnRegisterID.CNF" Destination="F_STRING_TO_WSTRING_1.REQ"/>
			<Connection Source="F_STRING_TO_WSTRING.CNF" Destination="ANYToJSON.REQ" dx1="265"/>
			<Connection Source="F_STRING_TO_WSTRING_1.CNF" Destination="ANYToJSON.REQ" dx1="260"/>
			<Connection Source="registerService.registerService" Destination="CreateRegisterID.REQ" dx1="1185"/>
			<Connection Source="registerService.unregisterService" Destination="CreateUnRegisterID.REQ" dx1="1185"/>
			<Connection Source="CLIENT_1_0.CNF" Destination="registerService.doneUnregister" dx1="570" dx2="60" dy="1740"/>
			<Connection Source="CLIENT_1_0_1.CNF" Destination="registerService.doneRegister" dx1="60" dx2="60" dy="175"/>
			<Connection Source="CLIENT_1_0_1.CNF" Destination="STRING2STRING.REQ"/>
			<Connection Source="STRING2STRING.CNF" Destination="registryDone" dx1="60" dx2="60" dy="-440"/>
			<Connection Source="E_DELAY.EO" Destination="CLIENT_1_0_1.REQ" dx1="195"/>
			<Connection Source="CLIENT_1_0_1.INITO" Destination="E_DELAY.START" dx1="60" dx2="60" dy="-200"/>
			<Connection Source="F_STRING_TO_WSTRING.CNF" Destination="CLIENT_1_0_1.INIT" dx1="2655"/>
			<Connection Source="F_STRING_TO_WSTRING_1.CNF" Destination="CLIENT_1_0.INIT" dx1="2300"/>
			<Connection Source="CLIENT_1_0.INITO" Destination="E_DELAY_1.START" dx1="60" dx2="330" dy="-160"/>
			<Connection Source="E_DELAY_1.EO" Destination="CLIENT_1_0.REQ" dx1="175"/>
		</EventConnections>
		<DataConnections>
			<Connection Source="CreateRegisterID.OUT" Destination="F_STRING_TO_WSTRING.IN"/>
			<Connection Source="CreateUnRegisterID.OUT" Destination="F_STRING_TO_WSTRING_1.IN"/>
			<Connection Source="registerService.serviceRegistryEntry" Destination="ANYToJSON.input" dx1="2595"/>
			<Connection Source="registerService.endpoint" Destination="CreateRegisterID.IN_2" dx1="755"/>
			<Connection Source="registerService.endpoint" Destination="CreateUnRegisterID.IN_2" dx1="765"/>
			<Connection Source="F_STRING_TO_WSTRING.OUT" Destination="CLIENT_1_0_1.ID"/>
			<Connection Source="ANYToJSON.output" Destination="CLIENT_1_0_1.SD_1" dx1="2355"/>
			<Connection Source="CLIENT_1_0_1.RD_1" Destination="STRING2STRING.IN" dx1="235"/>
			<Connection Source="STRING2STRING.OUT" Destination="registryStatus" dx1="60" dx2="60" dy="-515"/>
			<Connection Source="F_STRING_TO_WSTRING_1.OUT" Destination="CLIENT_1_0.ID" dx1="2300"/>
			<Connection Source="ANYToJSON.output" Destination="CLIENT_1_0.SD_1" dx1="1800"/>
		</DataConnections>
	</FBNetwork>
</FBType>
