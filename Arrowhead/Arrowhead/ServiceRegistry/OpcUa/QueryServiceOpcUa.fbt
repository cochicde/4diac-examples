<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="QueryServiceOpcUa" Comment="Query for Services using OPC UA">
	<Identification Standard="61499-2" Description="Copyright (c) 2019 fortiss GmbH&#10; &#10;This program and the accompanying materials are made&#10;available under the terms of the Eclipse Public License 2.0&#10;which is available at https://www.eclipse.org/legal/epl-2.0/&#10;&#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="fortiss GmbH" Version="1.0" Author="Jose Cabral" Date="2019-09-17">
	</VersionInfo>
	<InterfaceList>
		<Sockets>
			<AdapterDeclaration Name="queryServices" Type="QueryServicesAdp" x="2000" y="1400"/>
		</Sockets>
	</InterfaceList>
	<FBNetwork>
		<FB Name="APPEND_STRING_3" Type="APPEND_STRING_3" x="4860" y="2090">
			<Parameter Name="IN_1" Value="STRING#'opc_ua[CALL_METHOD;'"/>
			<Parameter Name="IN_3" Value="STRING#'#;/Objects/2:ServiceRegistry/2:query]'"/>
		</FB>
		<FB Name="F_STRING_TO_WSTRING" Type="F_STRING_TO_WSTRING" x="6155" y="2075">
		</FB>
		<FB Name="InitFlag" Type="E_SR" x="7435" y="1675">
		</FB>
		<FB Name="E_PERMIT" Type="E_PERMIT" x="8300" y="800">
		</FB>
		<FB Name="ANYToJSON" Type="ANYToJSON" x="3900" y="1400">
		</FB>
		<FB Name="GetHTTPResult" Type="GetArrayResponseFromJSON" x="500" y="1400">
		</FB>
		<FB Name="Query" Type="CLIENT_1" x="9060" y="1660">
		</FB>
		<FB Name="E_SWITCH_1" Type="E_SWITCH" x="12400" y="1500">
		</FB>
		<FB Name="E_SWITCH" Type="E_SWITCH" x="10500" y="1600">
		</FB>
		<FB Name="E_DELAY" Type="E_DELAY" x="14000" y="1500">
			<Parameter Name="DT" Value="T#250ms"/>
		</FB>
		<FB Name="E_CTU" Type="E_CTU" x="11600" y="1500">
			<Parameter Name="PV" Value="UINT#3"/>
		</FB>
		<EventConnections>
			<Connection Source="APPEND_STRING_3.CNF" Destination="F_STRING_TO_WSTRING.REQ" dx1="285"/>
			<Connection Source="F_STRING_TO_WSTRING.CNF" Destination="InitFlag.S" dx1="190"/>
			<Connection Source="ANYToJSON.CNF" Destination="APPEND_STRING_3.REQ" dx1="185"/>
			<Connection Source="queryServices.query" Destination="ANYToJSON.REQ"/>
			<Connection Source="GetHTTPResult.CNF" Destination="queryServices.queried"/>
			<Connection Source="InitFlag.EO" Destination="Query.INIT" dx1="295"/>
			<Connection Source="E_PERMIT.EO" Destination="Query.REQ" dx1="220"/>
			<Connection Source="Query.INITO" Destination="E_PERMIT.EI" dx1="60" dx2="60" dy="-1290"/>
			<Connection Source="E_SWITCH_1.EO0" Destination="E_DELAY.START"/>
			<Connection Source="E_CTU.CUO" Destination="E_SWITCH_1.EI"/>
			<Connection Source="E_SWITCH.EO0" Destination="E_CTU.CU" dx1="310"/>
			<Connection Source="E_SWITCH.EO1" Destination="GetHTTPResult.REQ" dx1="405" dx2="60" dy="-1900"/>
			<Connection Source="E_SWITCH.EO1" Destination="InitFlag.R" dx1="260" dx2="150" dy="-1650"/>
			<Connection Source="Query.CNF" Destination="E_SWITCH.EI" dx1="445"/>
			<Connection Source="E_SWITCH_1.EO1" Destination="InitFlag.R" dx1="60" dx2="60" dy="1350"/>
			<Connection Source="E_SWITCH_1.EO1" Destination="GetHTTPResult.REQ" dx1="60" dx2="360" dy="-2170"/>
			<Connection Source="E_DELAY.EO" Destination="Query.REQ" dx1="60" dx2="230" dy="-210"/>
			<Connection Source="E_SWITCH.EO1" Destination="E_CTU.R" dx1="310"/>
			<Connection Source="E_SWITCH_1.EO1" Destination="E_CTU.R" dx1="60" dx2="60" dy="120"/>
		</EventConnections>
		<DataConnections>
			<Connection Source="APPEND_STRING_3.OUT" Destination="F_STRING_TO_WSTRING.IN" dx1="285"/>
			<Connection Source="InitFlag.Q" Destination="E_PERMIT.PERMIT" dx1="205"/>
			<Connection Source="queryServices.serviceQueryForm" Destination="ANYToJSON.input"/>
			<Connection Source="queryServices.endpoint" Destination="APPEND_STRING_3.IN_2" dx1="325"/>
			<Connection Source="GetHTTPResult.output" Destination="queryServices.serviceEntries"/>
			<Connection Source="InitFlag.Q" Destination="Query.QI" dx1="370"/>
			<Connection Source="F_STRING_TO_WSTRING.OUT" Destination="Query.ID" dx1="840"/>
			<Connection Source="ANYToJSON.output" Destination="Query.SD_1" dx1="4045"/>
			<Connection Source="Query.RD_1" Destination="GetHTTPResult.response" dx1="60" dx2="60" dy="460"/>
			<Connection Source="E_CTU.Q" Destination="E_SWITCH_1.G"/>
			<Connection Source="Query.QO" Destination="E_SWITCH.G" dx1="445"/>
		</DataConnections>
	</FBNetwork>
</FBType>
